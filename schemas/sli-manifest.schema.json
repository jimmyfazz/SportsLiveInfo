{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sli.manifest/1",
  "title": "SportsLiveInfo feed manifest (v1/manifest.json)",
  "description": "Entry point for read-only B1G clients. Readers MUST ignore unknown fields, unknown assets and unknown capabilities, and MUST refuse a format_major they do not support (keeping their last good feed).",
  "type": "object",
  "required": ["feed", "format", "format_major", "format_minor", "compatibility", "revision", "generated_at", "publisher", "timezone_reference", "window", "refresh", "capabilities", "assets", "coverage", "rights", "display_policy", "notices"],
  "properties": {
    "feed": {"const": "sportsliveinfo"},
    "format": {"type": "string", "pattern": "^sli/[0-9]+\\.[0-9]+$"},
    "format_major": {"type": "integer", "minimum": 1},
    "format_minor": {"type": "integer", "minimum": 0},
    "compatibility": {
      "type": "object",
      "required": ["reader_major", "min_reader_minor", "unknown_fields", "unknown_assets", "unknown_enum_fallback"],
      "properties": {
        "reader_major": {"type": "integer"},
        "min_reader_minor": {"type": "integer"},
        "unknown_fields": {"const": "ignore"},
        "unknown_assets": {"const": "ignore"},
        "unknown_enum_fallback": {"type": "object"},
        "live_state_rule": {"type": "string", "description": "1.6+: when status_normalized 'live' may be shown as LIVE"},
        "live_overlay_rule": {"type": "string", "description": "1.6+: how the optional live asset overlays the day assets"},
        "tier_rule": {"type": "string", "description": "1.6+: which assets carry core and extra events"},
        "link_order": {"const": "best_first", "description": "0.3.24+: broadcast_links are published best first; readers keep the order"},
        "link_rule": {"type": "string", "description": "0.3.24+: how readers use link order and binds"},
        "live_until_rule": {"type": "string", "description": "0.3.24+: readers show LIVE while start_utc <= now < live_until_utc"},
        "live_max_age_minutes": {"type": "integer", "minimum": 1, "description": "0.3.24+: observation age limit used by live_state_rule, for readers without live_until_utc"},
        "live_end_grace_minutes": {"type": "integer", "minimum": 0, "description": "0.3.24+: minutes after expected_end_utc that live_state_rule still trusts 'live'"},
        "scores": {"type": "object", "required": ["enabled"], "description": "1.7+, present only while at least one source is approved for scores (kill switch: absent means scores are off and readers must show none)",
                   "properties": {"enabled": {"type": "boolean"}, "rule": {"type": "string", "description": "How readers pair and show scores"}}}
      }
    },
    "revision": {"type": "string", "pattern": "^[0-9a-f]{20}$"},
    "previous_revision": {"type": ["string", "null"]},
    "generated_at": {"type": "string"},
    "publisher": {"type": "object", "required": ["app", "version"]},
    "timezone_reference": {"const": "Europe/London"},
    "window": {"type": "object", "required": ["from", "to"]},
    "refresh": {
      "type": "object",
      "required": ["reader_poll_minutes", "stale_after_hours", "expires_at", "expected_interval_minutes"],
      "properties": {
        "reader_poll_minutes": {"type": "integer", "minimum": 5},
        "stale_after_hours": {"type": "integer", "minimum": 1},
        "expires_at": {"type": "string"},
        "expected_interval_minutes": {"type": "integer"},
        "live_stale_after_minutes": {"type": "integer", "minimum": 1, "description": "1.6, optional: a 'live' status older than this is never shown as LIVE"},
        "live_lane": {
          "type": "object",
          "description": "1.6, optional: the live-status lane. interval_minutes applies only while events are in play.",
          "required": ["enabled"],
          "properties": {
            "enabled": {"type": "boolean"},
            "interval_minutes": {"type": "integer", "minimum": 1},
            "active_only_while_events_in_play": {"type": "boolean"},
            "quiet_slots_guard_minutes": {"type": "integer", "minimum": 0},
            "last_run_utc": {"type": "string"}
          }
        }
      }
    },
    "capabilities": {"type": "array", "items": {"type": "string"}},
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "path", "sha256", "bytes", "schema", "content_type", "required"],
        "properties": {
          "kind": {"type": "string", "description": "taxonomy | channels | identity | dictionary | guide_map | events:YYYY-MM-DD | events_extra:YYYY-MM-DD (1.6, optional, tier extra) | today | live (1.6, optional, sli.live/1) | health | dictionary:uk-eu, dictionary:world-<region>[-n] (dictionary parts, only when the dictionary exceeds the 8 MiB reader cap) | guide_map:<n> (guide map parts, same rule) | (future kinds: ignore)"},
          "path": {"type": "string", "pattern": "^v1/assets/[a-z_]+/[0-9a-f]{24}\\.json$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 1},
          "schema": {"type": "string"},
          "content_type": {"const": "application/json"},
          "required": {"type": "boolean"},
          "date": {"type": "string"},
          "records": {"type": "integer"},
          "part": {"type": "object", "description": "Optional. Present on dictionary:* and guide_map:<n> assets: one part of a document too large for one reader asset (id, index, of, merge rule). `legacy_alias: true` marks the plain `dictionary` kind that points at the same file as dictionary:uk-eu.",
                   "required": ["id", "index", "of"],
                   "properties": {"id": {"type": "string"}, "index": {"type": "integer", "minimum": 1}, "of": {"type": "integer", "minimum": 1},
                                  "merge": {"type": "string"}, "legacy_alias": {"type": "boolean"}}}
        }
      }
    },
    "coverage": {"type": "object", "required": ["events", "today", "by_sport"],
      "properties": {"tiers": {"type": "object", "required": ["core", "extra"], "description": "1.6+: published events per tier",
                               "properties": {"core": {"type": "integer", "minimum": 0}, "extra": {"type": "integer", "minimum": 0}}},
                     "guide_corroborated_broadcasts": {"type": "integer", "minimum": 0, "description": "1.6+: broadcast links with status guide_corroborated"},
                     "verified_broadcasts": {"type": "integer", "minimum": 0}}},
    "rights": {
      "type": "object",
      "required": ["events", "epg_programmes", "attribution"],
      "properties": {
        "epg_programmes": {"const": "not_published"},
        "scores": {"type": "object", "required": ["approved_sources"], "description": "1.7+, present only while a source is approved for scores: the owner-approved score sources (config score_approvals)",
                   "properties": {"approved_sources": {"type": "array", "items": {"type": "string"}}}},
        "crests": {
          "type": "object",
          "description": "Optional (capability team_crests). Master kill switch: crests can be switched off centrally without a TV update. References only, never images.",
          "required": ["sources", "device_lookup", "monogram_only"],
          "properties": {
            "sources": {"type": "object", "properties": {"apisports": {"type": "object", "required": ["enabled", "url_template", "attribution", "cache_days"],
              "properties": {"enabled": {"type": "boolean"}, "url_template": {"type": "string"}, "attribution": {"type": "string"}, "cache_days": {"type": "integer", "minimum": 1}}}}},
            "device_lookup": {"type": "object", "properties": {"thesportsdb": {"type": "object", "required": ["enabled", "attribution"],
              "properties": {"enabled": {"type": "boolean"}, "attribution": {"type": "string"}}}}},
            "monogram_only": {"type": "boolean"}
          }
        },
        "attribution": {"type": "array", "items": {"type": "object", "required": ["source", "text", "licence"]}}
      }
    },
    "display_policy": {"type": "object", "required": ["sports_today_body_cards", "ppv_pinned_extra_card", "featured_tags", "user_settings_override"]},
    "notices": {"type": "array", "items": {"type": "string"}}
  }
}
